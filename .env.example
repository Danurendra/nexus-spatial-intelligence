# DinusNexus environment template.
# Copy to `.env` and fill in real values. Never commit `.env`.

# PostgreSQL (local Docker container: dinusnexus-postgres, host port 5434)
DATABASE_URL=postgresql+psycopg://dinusnexus:CHANGE_ME@127.0.0.1:5434/dinusnexus

# Dedicated database used only by the automated test suite.
TEST_DATABASE_URL=postgresql+psycopg://dinusnexus:CHANGE_ME@127.0.0.1:5434/dinusnexus_test

# DinusNexus API key required by protected endpoints (sent as X-API-Key).
DINUSNEXUS_API_KEY=change-this-to-a-random-value

# Comma-separated list of allowed browser origins (CORS).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Application
APP_NAME=DinusNexus
DEBUG=true

# File Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760  # 10MB

# LLM Configuration
# The IT Helpdesk workflow runs deterministically by default. Set LLM_ENABLED=true
# to add the optional `analyze_evidence` LLM step.
LLM_ENABLED=false

# LLM Provider (CBN Hackathon)
LLM_PROVIDER=primary
LLM_BASE_URL=https://litellm-hackathon.digdaya.ai/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=qwen3-coder-flash

# OpenAI configuration (fallback provider for chat and evidence analysis).
# gpt-5-nano is the lowest-cost current OpenAI text model.
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-5-nano
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_FALLBACK_ENABLED=true

# Bounded retry/timeout for transient provider errors (rate limit, timeout, 5xx).
LLM_MAX_ATTEMPTS=3
LLM_TIMEOUT_SECONDS=30
LLM_RETRY_BASE_DELAY=0.5

# GitHub MCP Server (jika digunakan)
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here

# Figma MCP Server (jika digunakan)
FIGMA_API_KEY=your_figma_api_key_here

# Azure (jika digunakan)
# Microsoft Foundry: disiapkan untuk integrasi, belum dipakai client LLM aplikasi.
AZURE_AI_PROJECT_ENDPOINT=https://dinusnexus-foundry.services.ai.azure.com/api/projects/proj-default
AZURE_OPENAI_BASE_URL=https://dinusnexus-foundry.openai.azure.com/openai/v1
# Isi API key secara manual di .env backend; jangan taruh di frontend.
AZURE_AI_API_KEY=

AZURE_SUBSCRIPTION_ID=your_subscription_id
AZURE_TENANT_ID=your_tenant_id
AZURE_CLIENT_ID=your_client_id
AZURE_CLIENT_SECRET=your_client_secret

# Vision Twin: blank uses the built-in OpenCV HOG pedestrian detector.
# Optional: path to a compatible YOLOv8/YOLOv5 COCO ONNX export for OpenCV DNN.
VISION_MODEL_PATH=
VISION_CONFIDENCE_THRESHOLD=0.25
